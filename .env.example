# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_* values are bundled into
# the app, so ONLY public values go here. Never put the Supabase service-role key or
# the Turnstile secret in the app.

# Supabase project (Singapore). Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile public site key (secret goes in Supabase Auth > CAPTCHA).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Origin of the backend static pages (backend/web): the WebView opens <origin>/captcha/.
EXPO_PUBLIC_TURNSTILE_BASE_URL=https://app.ryhnfir.dev

# Email links land here; the page opens dentisai://auth/callback. Must be listed in Supabase
# Auth > Redirect URLs and in the mailer's ALLOWED_REDIRECT_PREFIXES.
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://app.ryhnfir.dev/auth/callback

# DentisAI ML/AI API (backend/api, FastAPI; ADR 019). The app sends screening answers and on-device
# findings (never photos) to POST /v1/screening/evaluate; leave empty to evaluate on the device only.
EXPO_PUBLIC_API_BASE_URL=https://dentisin-api.azurewebsites.net
